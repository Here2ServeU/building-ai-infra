{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Models in Production",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "count(count by (model_name) (inference_requests_total))",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Inferences/sec (1m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(inference_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Error Rate (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } } },
      "targets": [
        {
          "expr": "sum(rate(inference_requests_total{code=~\"5..|4..\"}[5m])) / sum(rate(inference_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Inference Rate by Model",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (model_name) (rate(inference_requests_total[1m]))",
          "refId": "A",
          "legendFormat": "{{model_name}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Inference Latency (p50/p95/p99)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, model_name) (rate(inference_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "p50 {{model_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(inference_request_duration_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "p95 {{model_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, model_name) (rate(inference_request_duration_seconds_bucket[5m])))",
          "refId": "C",
          "legendFormat": "p99 {{model_name}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Average Prediction Confidence",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(model_prediction_confidence_sum[5m]) / rate(model_prediction_confidence_count[5m])",
          "refId": "A",
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "GPU Utilization (if applicable)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "refId": "A",
          "legendFormat": "{{instance}} gpu{{gpu}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["mlops", "model-serving", "red"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Model Serving — RED",
  "uid": "model-serving-red",
  "version": 1
}
