{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Population Stability Index (PSI) by Feature",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "model_feature_psi",
          "refId": "A",
          "legendFormat": "{{model_name}} / {{feature_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "orange", "value": 0.2 },
              { "color": "red", "value": 0.25 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Prediction Distribution Mean",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "avg_over_time(model_prediction_distribution_mean[1h])",
          "refId": "A",
          "legendFormat": "{{model_name}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Out-of-Distribution Detection Rate",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (model_name) (rate(model_ood_detections_total[5m]))",
          "refId": "A",
          "legendFormat": "{{model_name}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "table",
      "title": "Last Training Run by Model",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "max by (model_name) (model_last_training_run_timestamp_seconds)",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "Models Below F1 Promotion Gate",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [
        {
          "expr": "count(model_evaluation_f1_score < 0.92)",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["aiops", "drift", "mlops"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "title": "Model Drift & Training Health",
  "uid": "model-drift",
  "version": 1
}
